{
  "name": "campus-card",
  "version": "1.0.0",
  "description": "校园一卡通桌面客户端",
  "main": "main.js",
  "author": "杜星辉",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.campuscard",
    "productName": "校园一卡通",
    "directories": {
      "output": "release"
    },
    "electronVersion": "33.4.11",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "backend.jar",
        "to": "backend.jar"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
